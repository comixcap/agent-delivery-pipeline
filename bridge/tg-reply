#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Answer the operator via the Bot API.  Usage: tg-reply "text"   or   echo text | tg-reply
Long text is split into 3900-char chunks. Writes .last-reply so tg-poll stops "typing..."."""
import os
import sys
import time
import urllib.parse
import urllib.request

BASE = os.environ.get("PIPELINE_BRIDGE_DIR", os.path.expanduser("~/.pipeline/telegram"))
CHAT = os.environ.get("PIPELINE_TG_CHAT", "")


def chunks(text, size=3900):
    return [text[i:i + size] for i in range(0, len(text), size)]


def token():
    try:
        with open(f"{BASE}/.env", encoding="utf-8") as f:
            for line in f:
                if line.startswith("TELEGRAM_BOT_TOKEN="):
                    return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return ""


def main():
    text = " ".join(sys.argv[1:]).strip() or sys.stdin.read().strip()
    tok = token()
    if not text or not tok or not CHAT:
        print("no text, token or PIPELINE_TG_CHAT", file=sys.stderr)
        return 1
    for part in chunks(text):
        data = urllib.parse.urlencode({"chat_id": CHAT, "text": part,
                                       "disable_web_page_preview": "true"}).encode()
        try:
            urllib.request.urlopen(urllib.request.Request(
                f"https://api.telegram.org/bot{tok}/sendMessage", data=data), timeout=15).read()
        except Exception as e:  # noqa: BLE001
            print(f"not sent: {e}", file=sys.stderr)
            return 1
    try:
        with open(f"{BASE}/.last-reply", "w") as f:
            f.write(str(int(time.time())))
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
